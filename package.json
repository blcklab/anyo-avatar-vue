{
  "name": "@blcklab/anyo-avatar-vue",
  "version": "0.2.0-alpha.3",
  "description": "Vue 3 adapter, dynamic avatar component, and high-end host scene layer for @blcklab/anyo-avatar-viewer.",
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build && node scripts/check.mjs && node scripts/test-high-end-props.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@blcklab/anyo-avatar-viewer": "0.2.0-alpha.9",
    "@blcklab/anyo-avatar": "^0.2.0",
    "@blcklab/sekai64": ">=0.8.0-0 <0.9.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vue": "^3.5.0",
    "@blcklab/anyo-avatar-viewer": "0.2.0-alpha.9",
    "@blcklab/anyo-avatar": "0.2.1",
    "@blcklab/sekai64": "0.8.0-rc.34"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "license": "MIT",
  "author": "blcklab",
  "keywords": [
    "anyo",
    "vue",
    "avatar",
    "viewer",
    "vrm",
    "vrma",
    "gltf",
    "glb",
    "sekai64",
    "3d",
    "component"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blcklab/anyo-avatar-vue.git"
  },
  "bugs": {
    "url": "https://github.com/blcklab/anyo-avatar-vue/issues"
  },
  "homepage": "https://github.com/blcklab/anyo-avatar-vue#readme"
